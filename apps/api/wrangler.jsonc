{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gym-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // ADR-0010: mídias do catálogo (e futuramente a web) como arquivos estáticos.
  // Requisições a assets existentes são servidas direto pela CDN, sem executar o Worker
  // (não consomem a cota de requisições do Worker).
  // static/ é gerada (build web do Expo + public/): ver scripts/montar-assets.mjs e `pnpm deploy` na raiz.
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "BETTER_AUTH_URL": "https://gym-api.gym-api.workers.dev"
  },
  // Log de eventos por usuário (ADR-0006): 1 Durable Object por userId, com SQLite próprio.
  "durable_objects": {
    "bindings": [{ "name": "USER_STORE", "class_name": "UserStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserStore"] }],
  // Rate limiting por usuário (ADR-0014). Aproximado e por localidade: proteção contra abuso/bug em laço.
  "ratelimits": [
    { "name": "LIMITE_SYNC", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "LIMITE_CONTA", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // Identidade (ADR-0008): usuários, contas OAuth e sessões. Dados de treino NÃO ficam aqui (ADR-0006).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gym-identity",
      "database_id": "62efcd12-c483-42bc-9604-b2c486e66f77",
      "migrations_dir": "migrations"
    }
  ]
  // Segredos (wrangler secret put): BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
}
