{
  "name": "gym-app",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:arch": "depcruise apps packages --config .dependency-cruiser.cjs",
    "docs:arch": "depcruise apps/app/App.tsx apps/api/src packages --config .dependency-cruiser.cjs --output-type mermaid --output-to docs/architecture/dependencias.mmd",
    "deploy": "pnpm --filter @gym/app export:web && pnpm --filter @gym/api deploy",
    "catalogo:gerar": "node scripts/catalogo/gerar.ts",
    "e2e:web": "pnpm --filter @gym/app export:web && node apps/api/scripts/montar-assets.mjs && node scripts/e2e/rodar.mjs"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.8.0",
    "puppeteer-core": "^25.18.1",
    "turbo": "^2.11.12",
    "typescript": "~6.0.3"
  },
  "type": "module"
}
